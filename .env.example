# Creator Forge — Environment Variables
# Copy this file to .env and fill in your values

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (development):
# DATABASE_URL=sqlite:///./creator_forge.db

# Supabase PostgreSQL (production):
# Get from: app.supabase.com → project → Settings → Database → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Scraping ──────────────────────────────────────────────────────────────────
APIFY_API_KEY=

# ── Email / Outreach ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=partnerships@yourcompany.com
FROM_NAME=Creator Partnerships Team

# ── Safety controls ───────────────────────────────────────────────────────────
DAILY_SEND_LIMIT=10
MIN_FOLLOWERS_THRESHOLD=100000

# ── Ops Dashboard Auth ────────────────────────────────────────────────────────
# Simple password gate for /ops (used when Supabase is NOT configured)
# Add to web/.env.local:  VITE_OPS_PASSWORD=your-strong-password-here
VITE_OPS_PASSWORD=

# ── Frontend (Supabase + AI) ──────────────────────────────────────────────────
# Add to web/.env.local — these are exposed to the browser (safe, they're anon keys)
# Get from: supabase.com → project → Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Gemini API key (for AI Does It panel content generation)
VITE_GEMINI_API_KEY=

